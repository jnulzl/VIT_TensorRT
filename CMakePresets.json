{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Build_Release_Linux_Python311",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CMAKE_CXX_FLAGS": "-Wl,--warn-unresolved-symbols",
                "CUDA_HOME":"/usr/local/cuda-12.8",
                "TRT_HOME":"/mnt/data/jnulzl/Softwares/TensorRT-10.16.1.11.Linux.x86_64-gnu.cuda-12.9",
                "TRT_SRC_HOME":"/mnt/data/jnulzl/Softwares/TensorRT-src",
                "OpenCV_DIR":"/mnt/data/jnulzl/Softwares/opencv455",
                "LIBTORCH_DIR":"/mnt/data/jnulzl/Softwares/libtorch",
                "PYBIND11_ROOT":"/mnt/data/jnulzl/Softwares/pybind11-2.12.0",
                "PYTHON_API":"ON",
                "PYTHON_EXECUTABLE":"/mnt/data/jnulzl/miniconda3/envs/py311/bin/python"
            }
        },    
        {
            "name": "Build_Release_Linux_Python312",
            "inherits": "Build_Release_Linux_Python311",
            "cacheVariables": {
                "PYTHON_EXECUTABLE":"/mnt/data/jnulzl/miniconda3/envs/py312/bin/python"
            }
        },
        {
            "name": "Build_Release_Linux_Python310",
            "inherits": "Build_Release_Linux_Python311",
            "cacheVariables": {
                "PYTHON_EXECUTABLE":"/mnt/data/jnulzl/miniconda3/envs/py310/bin/python"
            }
        },
        {
            "name": "Build_Release_Linux_Python311_Win",
            "inherits": "Build_Release_Linux_Python311",
            "cacheVariables": {
                "CUDA_HOME":"/mnt/d/codes/third_party/Linux/cuda-12.8",
                "TRT_HOME":"/mnt/d/codes/third_party/Linux/TensorRT-10.10.0.31.Linux.x86_64-gnu.cuda-12.9",
                "OpenCV_DIR":"/mnt/d/codes/third_party/Linux/OpenCV455",
                "LIBTORCH_DIR":"/mnt/d/codes/third_party/Linux/libtorch-shared-with-deps-2.10.0+cu126", 
                "PYTHON_EXECUTABLE":"/home/jnulzl/miniconda3/envs/python311/bin/python"
            }
        },        
        {
            "name": "Build_Release_Linux_Python312_Win",
            "inherits": "Build_Release_Linux_Python311_Win",
            "cacheVariables": {
                "PYTHON_EXECUTABLE":"/home/jnulzl/miniconda3/envs/python312/bin/python"
            }
        },
        {
            "name": "Build_Release_Linux",
            "inherits": "Build_Release_Linux_Python311",
            "cacheVariables": {
                "PYTHON_API": "OFF"
            }
        }
    ]
}